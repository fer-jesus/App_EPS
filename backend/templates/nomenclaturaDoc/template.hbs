<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Documento Nomenclatura</title>
  <style>
  @page {
      size: letter portrait;
      margin: 0;
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
    }
     body {
      font-family: Arial, sans-serif;
      position: relative;
      z-index: 0;
    }
     body::before {
      content: '';    
      position: fixed;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background-image: url("{{imagenFondo}}");
      background-size: auto 100%; /* ESTIRA completamente la imagen hacia afuera */
      background-position: center top;
      background-repeat: no-repeat;
      opacity: 0.5; /* Ajusta la opacidad según sea necesario */
      background-color: rgba(255, 255, 255, 0.3);
      z-index: -1; /* Coloca la imagen detrás del contenido */
  }

    .firma {
     position: fixed; /* Fija la posición en la ventana */
     bottom: 120px;    /* Distancia desde el borde inferior */
     left: 0;
     right: 0;
     text-align: center;
     font-size: 14px;
     padding: 10px 0;
     z-index: 100;
     margin-top: 0;
     opacity: 0.9;
    }

    .firma .nombre {
      text-transform: uppercase;
      margin-bottom: 4px;
    }

    .firma .cargo {
      margin: 0;
      font-style: normal;
    }

      .nomenclatura-text {
      position: fixed;
      top: 35%; /* Ubicado un poco arriba del centro */
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 30px;
      font-weight: bold;
      color: #70ad47;
      opacity: 0.5;
      text-align: center;
      z-index: 10;
    }

  </style>
</head>
<body>

    <div style="
    position: fixed;
    top: 15%;
    right: 1.5cm;
    font-size: 14pt;
    font-weight: bold;
    color: #C00000;
    font-family: Arial, sans-serif;
    z-index: 10;
    text-align: right;
    min-width: 1ch;
    white-space: nowrap;
  ">
   No.<span style="font-weight: bold; color: #C00000;">{{id_nomenclatura}}</span>
  </div>

    <div class="nomenclatura-text">NOMENCLATURA</div>

<!-- Rectangulo con medidas específicas -->
<div style="
    position: fixed;
    width: 17.69cm;
    height: 8.5cm;
    top: 37%;  /* Ajusta para subir/bajar */
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 5;
    background: transparent;
    border-top: 1px solid #000;
    border-bottom: 1px solid #000;
    border-left: 1px solid #000;
    border-right: 1px solid #000;
    padding: 15px; 
">

<!-- REGISTRO GENERAL -->
    <div style="margin-top: 30px; margin-bottom: 100px; margin-left: 30px;">
        <div style="font-weight: bold; margin-bottom: 5px; color: #767171; font-size: 16px;">REGISTRO GENERAL</div>
         <span style="font-weight: bold;">{{registro_generalN}}</span>
    </div>

    <!-- SOLICITANTE -->
    <div style="margin-bottom: 50px; margin-left: 30px;">
        <div style="font-weight: bold; margin-bottom: 5px; color: #767171; font-size: 16px; display: inline-block;">SOLICITANTE</div>
       <span style="margin-left: 10px; font-weight: bold; text-transform: uppercase">{{solicitante}}</span>
    </div>

    <!-- DIRECCIÓN -->
    <div style="margin-left: 30px;">
        <div style="font-weight: bold; margin-bottom: 5px; color: #767171; font-size: 16px; display: inline-block;">DIRECCIÓN</div>
        <span style="margin-left: 10px; font-weight: bold; text-transform: uppercase">{{direccion}}</span>
    </div>

</div>

  <div class="contenido">

    <!-- Firma final -->
    {{#if firmaUsuario}}
    <div class="firma">
      <p class="nombre">{{usuario}}</p>
      <p class="cargo">{{rol_nombre}}</p>
      <p class="cargo">{{{institucion_firma}}}</p>
    </div>
    {{/if}}

  </div>
</body>
</html> 
